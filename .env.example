# Copy to .env and set your key locally. Do not put credentials in this template.
TYPESAFE_API_KEY=

# Local arena. Use the exact origin below in your browser.
ARENA_HOST=127.0.0.1
ARENA_PORT=8160
ARENA_ORIGIN=http://127.0.0.1:8160
ARENA_DATA_DIR=.arena-data
ARENA_MAX_CONCURRENT=1
ARENA_MAX_QUEUE=3
ARENA_DAILY_CALLS=500
ARENA_CALLS_PER_BATTLE=150
ARENA_TRUST_PROXY=0
# Optional persistent monthly input-token allowance; not a dollar spending cap.
# ARENA_MONTHLY_TOKENS=70000000
